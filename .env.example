# Copy to .env.local and fill in. Never commit .env.local.
# None of these use the NEXT_PUBLIC_ prefix, so they are never sent to the browser.

# Anthropic (text: follow-up questions, poems, symbol/mood extraction)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Image generation: provider name (only "none" exists for now) and its key
IMAGE_PROVIDER=none
IMAGE_API_KEY=

# Local SQLite file (folder is git-ignored)
DATABASE_PATH=./data/dream-painter.db
