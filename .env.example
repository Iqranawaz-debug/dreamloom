# Copy to .env.local and fill in. Never commit .env.local.
# None of these use the NEXT_PUBLIC_ prefix, so they are never sent to the browser.

# "true" (default) = built-in mock AI, no keys needed. "false" = real providers below.
USE_MOCK_AI=true
# Mock delay per AI call in ms (default 1000-2000, random). Scripts use 0.
# MOCK_AI_DELAY_MS=

# Text provider (when USE_MOCK_AI=false): "anthropic" or "gemini"
TEXT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Image provider (when USE_MOCK_AI=false): "mock", "openai" or "gemini".
IMAGE_PROVIDER=mock
# OpenAI GPT Image: only the generated image prompt is sent, never the raw dream text.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Any WIDTHxHEIGHT the model accepts, or auto. Portrait suits the diary.
OPENAI_IMAGE_SIZE=1024x1536
# low | medium | high | auto (higher costs more)
OPENAI_IMAGE_QUALITY=medium

# Google Gemini: one key for text and images (aistudio.google.com).
# Text has a free tier, but Google may use free-tier data to improve its products.
# Images are paid only. Painters get the image prompt, never the raw dream text.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# 1:1 2:3 3:2 3:4 4:3 4:5 5:4 9:16 16:9 21:9
GEMINI_IMAGE_ASPECT=2:3
# 512 1K 2K 4K (bigger costs more)
GEMINI_IMAGE_SIZE=1K

# Extra hostnames allowed to reach the app, comma separated (localhost and private IPs always work).
# ALLOWED_HOSTS=

# Local SQLite file; paintings are stored next to it in data/dreams/ (git-ignored)
DATABASE_PATH=./data/dream-painter.db
